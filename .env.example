# Copy to .env and load explicitly. Never commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=reachmarkofficial@gmail.com
SMTP_PASSWORD=''
SMTP_FROM=reachmarkofficial@gmail.com
SUPPORT_EMAIL=support@reachmarkdigital.xyz
# Max outreach sends per calendar day (UTC date prefix). Approval + suppression still required.
SEND_DAILY_CAP=40
DASHBOARD_PASSWORD=''
PORT=8000
# Live public origin (sitemap, canonical, mail, Google OAuth). Never a *.up.railway.app host.
PUBLIC_BASE_URL=https://reachmarkdigital.xyz

# Optional absolute path on a persistent disk; omit to use the project directory.
# DATABASE_PATH=/data/reachmark.sqlite3

# Optional dedicated Bearer token for a remote MCP connector.
# Enter only this variable NAME in the UI; set its secret VALUE privately on your host.
# Authenticated MCP connections also require a strong DASHBOARD_PASSWORD.
# MCP_TOKEN_DESIGN=''

# Optional: contracted/self-hosted Overpass endpoints; at most two, comma-separated.
# Defaults use public community services (no uptime guarantee or bulk-world harvesting).
# OVERPASS_URLS=https://your-approved-overpass.example/api/interpreter

# Maps JavaScript / Places Autocomplete for Global finder. Restrict this key
# in Google Cloud to HTTP referrers https://reachmarkdigital.xyz/*
# GOOGLE_MAPS_API_KEY=''
# Optional: Google Places API (New) key. When set, the Scout reads Google Maps
# business profiles in addition to OpenStreetMap and merges the two sources.
# Leave unset to stay OpenStreetMap-only (no key, no billing).
# GOOGLE_PLACES_API_KEY=''
# Public WhatsApp icon. Default is https://wa.me/14473227700. Set off to hide.
# WHATSAPP_URL=https://wa.me/14473227700

# Preview/development only. Production secrets belong in .env.production on the host.
APP_ENV=development
# DASHBOARD_PASSWORD is accepted only outside production.
# SECRET_KEY may be omitted locally; the app generates an ephemeral development key.
# DATABASE_PATH may be set to a local path for development; production uses /data/reachmark.sqlite3.

# --- AI crew (optional) -------------------------------------------------------
# The crew runs with no key at all: every agent has a deterministic engine and the
# receptionist answers from knowledge/reachmark.md. A provider only improves phrasing.
# Local models with Ollama — no key, no cost, nothing leaves your machine:
#   ollama serve && ollama pull llama3.1
# OLLAMA_HOST=http://127.0.0.1:11434
# CREW_LLM_PROVIDER=ollama          # auto | ollama | openai | anthropic | none
# CREW_LLM_MODEL=llama3.1
#
# Cloud providers (leave OLLAMA_HOST unset):
# CREW_LLM_PROVIDER=auto            # auto | ollama | openai | anthropic | none
# CREW_LLM_API_KEY=''
# CREW_LLM_MODEL=gpt-4o-mini
# CREW_LLM_BASE_URL=https://api.openai.com/v1
# CREW_LLM_TIMEOUT=25
# CREW_LLM_BUDGET=12                # completion calls allowed per crew run
# CREW_LLM_SEND_CONTACTS=0          # 1 = send e-mail addresses/phones to the provider (default: masked)
#
# Brag ad video (optional renderer; needs playwright + imageio-ffmpeg)
# CREW_VIDEO_RENDER=1               # 0 = write the brief only, never render

# Crew guardrails (defaults shown; change only if you understand the trade-off)
# CREW_MAX_DISPATCHES=5             # approved outbound items per run
# CREW_ONE_PER_DAY=1                # one message per business per 24 hours

# --- Google Search Console + AdSense (optional) ------------------------------
# Paste the NEW Search Console HTML-tag token(s) here, comma-separated.
# Leave blank until the new token is provided; old tokens are intentionally removed.
GOOGLE_SITE_VERIFICATION=
# AdSense publisher ID supplied for Reachmark; override only if your AdSense account changes.
ADSENSE_CLIENT=ca-pub-5678865896620902
# Display ad slot from the AdSense console (Ads > By ad unit > Display > copy
# the data-ad-slot number). Enables the labelled on-page placements on / and
# /showcase; leave blank for Auto ads only (no empty boxes are ever rendered).
# ADSENSE_DISPLAY_SLOT=1234567890

# --- Google Business Profile -----------------------------------------------
# OAuth credentials for the Google Cloud project used by Reachmark.
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
# Optional fixed callback URLs for deployed previews/production.
# Register these exact URLs in Google Cloud OAuth credentials.
# Client sign-in/sign-up MUST be .../api/auth/oauth/google/callback
# (leave blank to use PUBLIC_BASE_URL + that path). Never point this at
# the Business Profile callback.
GOOGLE_OAUTH_REDIRECT_URI=https://reachmarkdigital.xyz/api/auth/oauth/google/callback
GOOGLE_BUSINESS_REDIRECT_URI=https://reachmarkdigital.xyz/api/google-business/oauth/callback
# Fernet key used to encrypt Google access/refresh tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_BUSINESS_TOKEN_KEY=''

# --- Reachmark Digital outreach providers ----------------------------------
# Server-side only. Never expose these values to browser code.
# Instantly API v2: https://api.instantly.ai/api/v2
INSTANTLY_API_KEY=''
INSTANTLY_API_BASE=https://api.instantly.ai/api/v2
INSTANTLY_WEBHOOK_SECRET=''
# Smartlead API v1: https://server.smartlead.ai/api/v1
SMARTLEAD_API_KEY=''
SMARTLEAD_API_BASE=https://server.smartlead.ai/api/v1
SMARTLEAD_WEBHOOK_SECRET=''
