# Copy to .env and load explicitly. Never commit real credentials.
SMTP_HOST=''
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=''
SMTP_PASSWORD=''
SMTP_FROM=''
DASHBOARD_PASSWORD=''
PORT=8000

# Optional absolute path on a persistent disk; omit to use the project directory.
# DATABASE_PATH=/data/sitegap.sqlite3

# Optional dedicated Bearer token for a remote MCP connector.
# Enter only this variable NAME in the UI; set its secret VALUE privately on your host.
# Authenticated MCP connections also require a strong DASHBOARD_PASSWORD.
# MCP_TOKEN_DESIGN=''

# Optional: contracted/self-hosted Overpass endpoints; at most two, comma-separated.
# Defaults use public community services (no uptime guarantee or bulk-world harvesting).
# OVERPASS_URLS=https://your-approved-overpass.example/api/interpreter

# Production configuration: generate on the host using scripts/configure_owner.py.
# Never use these placeholders as credentials.
APP_ENV=development
# SECRET_KEY=<random 32+ character secret>
# OWNER_PASSWORD_HASH='<scrypt hash from the setup helper>'
# Paystack secret key (live sk_live_... or test sk_test_...) for workspace plans.
# Without it, /pricing shows plans but checkout reports "not connected".
# PAYSTACK_SECRET_KEY=''
# PUBLIC_BASE_URL=https://your-owned-domain.example
# SENTRY_DSN=<optional error monitoring DSN>
# RELEASE_SHA=<set by image build>
# BACKUP_DIR=/backups
# BACKUP_HEALTHCHECK_URL belongs in .env.backup, along with optional restic credentials.

# --- AI crew (optional) -------------------------------------------------------
# The crew runs with no key at all: every agent has a deterministic engine and the
# receptionist answers from knowledge/reachmark.md. A provider only improves phrasing.
# Local models with Ollama — no key, no cost, nothing leaves your machine:
#   ollama serve && ollama pull llama3.1
# OLLAMA_HOST=http://127.0.0.1:11434
# CREW_LLM_PROVIDER=ollama          # auto | ollama | openai | anthropic | none
# CREW_LLM_MODEL=llama3.1
#
# Cloud providers (leave OLLAMA_HOST unset):
# CREW_LLM_PROVIDER=auto            # auto | ollama | openai | anthropic | none
# CREW_LLM_API_KEY=''
# CREW_LLM_MODEL=gpt-4o-mini
# CREW_LLM_BASE_URL=https://api.openai.com/v1
# CREW_LLM_TIMEOUT=25
# CREW_LLM_BUDGET=12                # completion calls allowed per crew run
# CREW_LLM_SEND_CONTACTS=0          # 1 = send e-mail addresses/phones to the provider (default: masked)
#
# Brag ad video (optional renderer; needs playwright + imageio-ffmpeg)
# CREW_VIDEO_RENDER=1               # 0 = write the brief only, never render

# Crew guardrails (defaults shown; change only if you understand the trade-off)
# CREW_MAX_DISPATCHES=5             # approved outbound items per run
# CREW_ONE_PER_DAY=1                # one message per business per 24 hours

# --- Google AdSense (optional) ----------------------------------------------
# ADSENSE_CLIENT is built in (ca-pub-3894582071697384); override only to switch account.
# ADSENSE_CLIENT=ca-pub-3894582071697384
# Display ad slot from the AdSense console (Ads > By ad unit > Display > copy
# the data-ad-slot number). Enables the labelled on-page placements on / and
# /showcase; leave blank for Auto ads only (no empty boxes are ever rendered).
# ADSENSE_DISPLAY_SLOT=1234567890
