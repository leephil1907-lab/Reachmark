{
  "name": "reachmark",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Reachmark — Find the leak. Win them with proof.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:legacy": "npm run build:menu && npm run build:intelligence",
    "build:menu": "esbuild frontend/menu.jsx --bundle --minify --outfile=static/motion-menu.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:intelligence": "esbuild frontend/intelligence.jsx --bundle --minify --outfile=static/intelligence.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "build": "npm run build:legacy && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lenis": "^1.1.20",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}