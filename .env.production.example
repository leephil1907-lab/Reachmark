# Reachmark production environment template.
# Copy to .env.production on the production host and chmod 600.
# Never commit the populated file or paste real secrets into Git.
APP_ENV=production
PUBLIC_BASE_URL=https://your-owned-domain.example
DOMAIN=your-owned-domain.example
PORT=8000
DATABASE_PATH=/data/reachmark.sqlite3
SECRET_KEY=<generate-a-random-secret-at-least-32-characters>
OWNER_PASSWORD_HASH=<scrypt-or-pbkdf2-hash-from-scripts/configure_owner.py>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=<verified-sender@example.com>
CRON_SECRET=<random-cron-secret>
PAYSTACK_SECRET_KEY=<paystack-secret-if-billing-is-enabled>
SENTRY_DSN=<optional-sentry-dsn>
RELEASE_SHA=<set-by-the-release-image>
BACKUP_DIR=/backups

# Optional integrations; leave unset when not used.
SMARTSUPP_KEY=
GOOGLE_SITE_VERIFICATION=
GOOGLE_PLACES_API_KEY=
OVERPASS_URLS=

# Optional AI crew provider. The deterministic crew works without a provider.
CREW_LLM_PROVIDER=none
CREW_LLM_API_KEY=
CREW_LLM_MODEL=
CREW_LLM_BASE_URL=
CREW_LLM_TIMEOUT=25
CREW_LLM_BUDGET=12
CREW_LLM_SEND_CONTACTS=0
CREW_VIDEO_RENDER=0
CREW_MAX_DISPATCHES=5
CREW_ONE_PER_DAY=1

# Optional AdSense configuration.
ADSENSE_CLIENT=
ADSENSE_DISPLAY_SLOT=
