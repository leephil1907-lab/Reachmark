# Production only. Copy to .env.production on the host; never commit the populated file.
APP_ENV=production
SECRET_KEY=
OWNER_PASSWORD_HASH=
PUBLIC_BASE_URL=https://your-owned-domain.example
DATABASE_PATH=/data/reachmark.sqlite3
PORT=8000

# Mail is required only if production outreach is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Billing: required to enable Paystack checkout.
PAYSTACK_SECRET_KEY=

# Optional OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional monitoring / AI providers.
SENTRY_DSN=
CREW_LLM_PROVIDER=none
CREW_LLM_API_KEY=
CREW_LLM_MODEL=
CREW_LLM_BASE_URL=

# Public, non-secret identifiers may be configured separately.
GOOGLE_SITE_VERIFICATION=
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_ID=
GOOGLE_TAG_MANAGER_ID=
ADSENSE_CLIENT=
ADSENSE_DISPLAY_SLOT=

# Optional approved map provider configuration.
OVERPASS_URLS=
GOOGLE_PLACES_API_KEY=
